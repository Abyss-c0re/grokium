# Grokium entry — zero telemetry, local-first
# Primary: TUI  (`grokium` / `grokium tui`)
# Optional: web+API (`grokium serve` → :17444)
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export PYTHONPATH="${ROOT}/src${PYTHONPATH:+:$PYTHONPATH}"
export GROKIUM_CONFIG="${GROKIUM_CONFIG:-$ROOT/config/grokium.toml}"
exec python3 -m grokium.cli "$@"
